{
    "name": "pokemon-rom-extractor",
    "version": "1.0.0",
    "description": "Extract data from Pokemon Red/Blue ROM files",
    "main": "src/index.js",
    "type": "module",
    "scripts": {
        "start": "node src/index.js all",
        "extract:all": "node src/index.js all",
        "extract:pkmn": "node src/index.js pkmn",
        "extract:maps": "node src/index.js maps",
        "extract:names": "node src/index.js names",
        "extract:overworld": "node src/extractOverworldSprites.js",
        "dev": "node server.js",
        "dev:minify": "cross-env MINIFY=true node server.js",
        "http-server": "http-server ./ -p 8080",
        "serve": "node server.js",
        "serve:minify": "cross-env MINIFY=true node server.js",
        "world-map": "http-server ./ -p 8080 -o /webclient/world-map.html",
        "viewer": "http-server ./ -p 8080 -o /webclient/index.html"
    },
    "keywords": [
        "pokemon",
        "rom",
        "gameboy",
        "extractor"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "cross-env": "^10.1.0",
        "pngjs": "^7.0.0"
    },
    "devDependencies": {
        "compression": "^1.8.1",
        "express": "^5.2.1",
        "html-minifier-terser": "^7.2.0",
        "http-server": "^14.1.1",
        "terser": "^5.44.1"
    }
}
